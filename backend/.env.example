# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string.
# Locally (e.g. Postgres.app / Docker): postgres://postgres:postgres@localhost:5432/mama_joys_cosmetics
# On Render: use the "Internal Database URL" from your Render Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/mama_joys_cosmetics

# Set to "true" on Render (and any host requiring SSL to Postgres). Leave
# unset/false for a local Postgres install without SSL.
DB_SSL=false

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string

# CORS - comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Where uploaded product photos are stored.
# Locally this defaults to a folder inside the project if left unset.
# On Render, set this to the mount path of your persistent disk, e.g. /var/data/uploads
UPLOAD_DIR=./uploads

# Paystack - https://dashboard.paystack.com/#/settings/developers
# Use your real secret key in a local .env file only; never commit it to Git.
PAYSTACK_SECRET_KEY=replace_with_your_paystack_secret_key
PAYSTACK_CALLBACK_URL=https://your-frontend.vercel.app/payment/callback

# Used only once, by scripts/seedAdmin.js, to create the first admin login
ADMIN_NAME=Mama Joy
ADMIN_EMAIL=admin@mamajoyscosmetics.com
ADMIN_PASSWORD=change_this_password
